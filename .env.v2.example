PORT=4000

# Varian V2 = dengan role production.
# DB lokal: server/data/db.v2.json (+ server/uploads-v2)
EFISA_VARIANT=v2

# Kosongkan = mode lokal. Isi keduanya = mode Supabase (proyek "efisa v2",
# JANGAN pakai proyek yang sama dengan main).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Opsional, default: efisa-uploads (sarankan bucket berbeda per varian)
SUPABASE_UPLOADS_BUCKET=efisa-uploads-v2
