PORT=4000

# Varian ganda (lihat .env.main.example / .env.v2.example):
# EFISA_VARIANT=main -> DB lokal server/data/db.main.json (+ uploads-main)
# EFISA_VARIANT=v2   -> DB lokal server/data/db.v2.json (+ uploads-v2)
# Kosong             -> server/data/db.json (+ uploads) [kompatibel lama]
EFISA_VARIANT=
# Override penuh (opsional, mengalahkan EFISA_VARIANT):
# DB_FILE=server/data/db.main.json
# UPLOADS_DIR=server/uploads-main

# Kosongkan = mode lokal (JSON di server/data + file di server/uploads*)
# Isi = mode Supabase (wajib untuk Vercel)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Opsional, default: efisa-uploads
SUPABASE_UPLOADS_BUCKET=efisa-uploads
