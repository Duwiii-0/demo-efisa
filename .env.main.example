PORT=4000

# Varian MAIN = tanpa role production.
# DB lokal: server/data/db.main.json (+ server/uploads-main)
EFISA_VARIANT=main

# Kosongkan = mode lokal. Isi keduanya = mode Supabase (proyek KHUSUS main,
# JANGAN pakai proyek yang sama dengan v2).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Opsional, default: efisa-uploads
SUPABASE_UPLOADS_BUCKET=

